# ==============================================================================
# Task Assistant Agent Configuration
# ==============================================================================

# 1. AI / LLM Engine (Supports Ollama local Qwen and Google Gemini)
# LLM_PROVIDER: "ollama" (Local, offline, privacy) or "gemini" (Cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# (Tùy chọn) Google Gemini AI Model & Key khi dùng LLM_PROVIDER=gemini
# Lấy API key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2. Server Configuration
HOST=127.0.0.1
PORT=8000

# 3. SMTP Email Dispatcher (Tùy chọn: để gửi email thật qua Gmail / Outlook / Mailtrap)
# Nếu để trống, hệ thống sẽ tự động lưu email vào Mock Outbox để xem trước
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=assistant@taskagent.local
SMTP_TLS=true
DEV_EMAIL=developer@company.com

# 4. Proactive Morning Reminder (APScheduler)
REMINDER_HOUR=9
REMINDER_MINUTE=0
